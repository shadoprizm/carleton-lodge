# Required for Supabase client
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backward-compatible flag: true exposes the administrator-only Lodge Guide pilot
VITE_ASK_CARLETON_ENABLED=false

# Server-side only: configure in Supabase Edge Function secrets (not in frontend env)
# GOOGLE_PLACES_API_KEY=your-google-places-api-key
# MXROUTE_API_SERVER=sunfire.mxrouting.net
# MXROUTE_API_USERNAME=your-directadmin-username
# MXROUTE_API_KEY=your-mxroute-api-key
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=your-resend-api-key
# EMAIL_FROM=Carleton Lodge No. 465 <help@carpmasons.ca>
# SITE_URL=https://www.carpmasons.ca
# LODGE_GUIDE_ACCESS=admins
